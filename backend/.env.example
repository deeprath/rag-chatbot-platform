# Copy to .env for local development. Never commit the real .env file.

# --- App ---
APP_NAME="RAG Chatbot API"
ENVIRONMENT=local
DEBUG=true

# --- Database (TimescaleDB / Postgres + pgvector) ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_chatbot
DB_ECHO=false

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents

# --- Keycloak ---
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=rag-chatbot
KEYCLOAK_CLIENT_ID=rag-chatbot-backend
KEYCLOAK_AUDIENCE=rag-chatbot-backend
# Only needed when the backend reaches Keycloak by a different address than the
# browser does (e.g. docker-compose: KEYCLOAK_SERVER_URL=http://keycloak:8080
# internally, but tokens are issued with iss=http://localhost:8080). Leave unset
# for plain local dev, where both are the same address.
KEYCLOAK_ISSUER_URL=

# --- LLM provider: "anthropic", "openai", or "ollama" ---
# "ollama" needs no API key — it talks to a local Ollama server (see
# infra/README.md for running one via docker-compose) and is a convenient
# free stand-in until ANTHROPIC_API_KEY/OPENAI_API_KEY are set up.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_TEMPERATURE=0.2

# Encrypts per-user API keys saved via the frontend's Settings page (see
# docs/SECURITY.md) — required only once a user actually saves a key there.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- Embeddings (local HF model, no API key needed) ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- RAG tuning ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
