# Copy to .env.local for local development.

# Base URL of the Kong gateway (which proxies to the FastAPI backend).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Keycloak (OIDC) settings — must match infra/keycloak/realm-export.json
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=rag-chatbot
VITE_KEYCLOAK_CLIENT_ID=rag-chatbot-frontend
