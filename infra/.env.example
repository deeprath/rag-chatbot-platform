# Copy to infra/.env for docker-compose (docker compose loads infra/.env automatically).
# These are consumed by docker-compose.yml's ${VAR} substitutions.

# --- LLM provider (see backend/app/services/llm_provider.py) ---
# "ollama" needs no API key — see the "Using Ollama" section in this
# directory's README.md, and infra/Makefile's `ollama-up` target, for the
# one-time model pull. It's optional/resource-heavy and off by default.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=llama3.2:1b

# Encrypts per-user API keys saved via the frontend's Settings page — required
# once a user saves a key there (see docs/SECURITY.md). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- TimescaleDB ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_chatbot

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
